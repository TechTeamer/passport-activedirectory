{
  "name": "passport-activedirectory",
  "version": "1.4.0",
  "description": "Active Directory strategy for passport.js",
  "license": "MIT",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhoriuchi/passport-activedirectory.git"
  },
  "type": "module",
  "scripts": {
    "build:copybrc": "cp build/.build.babelrc src/.babelrc",
